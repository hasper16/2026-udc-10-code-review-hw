@@ -0,0 +1,17 @@
+import { AccessDenied } from "./auth.js";
+
+/**
+ * Book catalogue, one page at a time, sorted by title. Any signed-in user
+ * may browse it. `page` is 1-based.
+ */
+export function listBooksPage(db, user, { page = 1, limit = 20 } = {}) {
+  if (!user) throw new AccessDenied();
+  const sorted = [...db.books].sort((a, b) => a.title.localeCompare(b.title, "uk"));
+  const offset = page * limit;
+  return {
+    page,
+    limit,
+    total: sorted.length,
+    items: sorted.slice(offset, offset + limit).map(({ id, title, author }) => ({ id, title, author })),
+  };
+}
